{
  "format": 1,
  "mode": "standard-gamepad-emulation",
  "nativeSteamInputApi": false,
  "actionSet": "gameplay",
  "reserved": ["Steam", "Quick Access", "Shift+Tab"],
  "buttons": [
    { "index": 0, "position": "south", "action": "confirm" },
    { "index": 1, "position": "east", "action": "cancel" },
    { "index": 2, "position": "west", "action": "interact" },
    { "index": 3, "position": "north", "action": "openMenu" },
    { "index": 4, "position": "left-bumper", "action": "battleTargetPrevious" },
    { "index": 5, "position": "right-bumper", "action": "battleTargetNext" },
    { "index": 6, "position": "left-trigger", "action": "battleLogUp" },
    { "index": 7, "position": "right-trigger", "action": "battleLogDown" },
    { "index": 8, "position": "view", "action": "openTips" },
    { "index": 9, "position": "menu", "action": "openMenu" },
    { "index": 12, "position": "dpad-up", "action": "navigateUp" },
    { "index": 13, "position": "dpad-down", "action": "navigateDown" },
    { "index": 14, "position": "dpad-left", "action": "navigateLeft" },
    { "index": 15, "position": "dpad-right", "action": "navigateRight" }
  ],
  "axes": [
    { "index": 0, "direction": -1, "action": "navigateLeft" },
