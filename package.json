{
  "name": "2dnd",
  "version": "1.1.0",
  "description": "2D&D - A browser and desktop JRPG with Dragon Quest gameplay and D&D mechanics",
  "type": "module",
  "main": "dist-electron/main.js",
  "desktopName": "2D-and-D.desktop",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "npm run build:electron && node hacks/run-desktop-dev.mjs",
    "build": "npm run typecheck && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:desktop": "npm run typecheck && npm run build:electron && vite build --mode desktop",
    "generate:desktop-icons": "node hacks/generate-desktop-icons.mjs",
    "package:desktop": "npm run generate:desktop-icons && npm run build:desktop && electron-builder --publish never",
    "package:desktop:ci": "electron-builder --publish never",
    "benchmark:baseline": "node hacks/measure-performance-baseline.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "node hacks/run-browser-tests.mjs",
    "test:browser:install": "playwright install chromium",
    "test:desktop": "npm run build:desktop && playwright test --config=playwright.desktop.config.ts",
    "test:desktop:built": "playwright test --config=playwright.desktop.config.ts",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck:web && npm run typecheck:desktop",
    "typecheck:web": "tsc --noEmit",
    "typecheck:desktop": "tsc -p tsconfig.electron.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbianchidev/2dnd.git"
  },
  "keywords": [
    "game",
    "jrpg",
    "dnd",
    "phaser"
  ],
  "author": "",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/mbianchidev/2dnd/issues"
  },
  "homepage": "https://github.com/mbianchidev/2dnd#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "electron": "^43.4.0",
    "electron-builder": "26.15.7",
    "happy-dom": "^20.11.2",
    "phaser": "^4.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "dev.mbianchidev.2dnd",
    "productName": "2D&D",
    "executableName": "2D-and-D",
    "asar": true,
    "npmRebuild": false,
    "artifactName": "2D-and-D-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.role-playing-games",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "2D-and-D-${version}-windows-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "2D-and-D-${version}-windows-${arch}-portable.${ext}"
    },
    "linux": {
      "category": "Game",
      "icon": "build/icons",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "overrides": {
    "@electron/asar": "4.2.1",
    "global-agent": "4.1.3"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
