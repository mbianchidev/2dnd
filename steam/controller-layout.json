    { "index": 1, "direction": -1, "action": "navigateUp" },
    { "index": 1, "direction": 1, "action": "navigateDown" }
  ],
  "cursor": {
    "axes": [2, 3],
    "clickButton": 11,
    "rightTrackpad": "optional right-stick emulation",
